# Production origin (used for canonical URLs, sitemap, schema). Leave unset on previews.
SITE_URL=
# Set to "true" only on the live production deployment. Anything else adds noindex to every page.
ALLOW_INDEXING=
# Google Tag Manager container (Certify Services Ltd), e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=
# Quote form delivery (server-side only)
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
