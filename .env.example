# Production origin (canonical URLs, sitemap, schema). Defaults to https://www.tandtfiresafety.co.uk.
SITE_URL=
# Production deploys are indexable by default; previews never are. "false" turns indexing off in production.
ALLOW_INDEXING=
# Google Tag Manager container (Certify Services Ltd), e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=

# Quote form delivery (server-side only). Leads are emailed AND saved; either alone also works.
# Email via Resend. The sending domain must be verified in Resend.
RESEND_API_KEY=
# The inbox that receives each lead (comma-separate for several), e.g. Philip's Certify inbox.
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL="T&T Fire Safety <leads@tandtfiresafety.co.uk>"
# Database: Supabase "Certi Sprint" project, table public.tandt_leads (separate from Certi Sprint's enquiries).
# Secret key: Supabase → Certi Sprint → Project Settings → API Keys → Secret key (sb_secret_...). Never expose it.
SUPABASE_URL=https://etdmtdjwcsyriiknbawa.supabase.co
SUPABASE_SECRET_KEY=
