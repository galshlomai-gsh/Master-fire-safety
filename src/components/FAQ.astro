---
import type { FAQ } from '../data/types';
import { faqSchema } from '../lib/schema';
interface Props { faqs: FAQ[]; title?: string; schema?: boolean }
const { faqs, title = 'Frequently asked questions', schema = true } = Astro.props;
---
<section class="sec-faq reveal" aria-labelledby="faq-h">
  <div class="wrap">
    <h2 id="faq-h">{title}</h2>
    <div class="faqs">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
          <div class="ans"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />}
</section>
