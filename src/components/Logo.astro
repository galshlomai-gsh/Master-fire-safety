---
/**
 * The single brand lockup. Swap the brand in src/config/site.ts.
 * Fire mark A renders only when site.brand.fireMarkApproved is true.
 */
import { site } from '../config/site';
interface Props { reversed?: boolean; href?: string }
const { reversed = false, href = '/' } = Astro.props;
const b = site.brand;
---
<a href={href} class:list={['logo', { rev: reversed }]} aria-label={`${b.name}: home`}>
  <span class="mark" aria-hidden="true">{b.wordmark}</span>
  {b.fireMarkApproved ? (
    <svg class="firemark" viewBox="0 0 100 100" aria-hidden="true">
      <rect width="100" height="100" fill="#C9232C" />
      <path d="M50 86 31 67V47l8-10 4-7 3 17 12-33 12 22v30z" fill="#fff" />
    </svg>
  ) : (
    <span class="rule" aria-hidden="true"></span>
  )}
  <span class="desc" aria-hidden="true">{b.descriptor}</span>
</a>
