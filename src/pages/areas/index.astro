---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas } from '../../data/areas';
const crumbs = [{ name: 'Areas', href: '/areas' }];
const groups = [
  {
    eyebrow: 'London',
    lead: 'Our main focus. Freeholders, managing agents, HMO landlords and businesses across every London borough, with dedicated pages for the boroughs we work in most.',
    list: areas.filter((a) => a.slug === 'greater-london' || a.parent === 'greater-london'),
  },
  {
    eyebrow: 'Home Counties',
    lead: 'Hertfordshire, and the parts of Essex, Kent, Surrey, Berkshire and Buckinghamshire within easy reach of London.',
    list: areas.filter((a) => a.slug !== 'greater-london' && !a.parent),
  },
];
---
<BaseLayout
  title="Areas We Cover | London & the Home Counties | T&T Fire Safety"
  description="Fire risk assessments and fire safety services across London, including Barnet, Brent, Camden, Harrow, Haringey and Islington, and the Home Counties. Free quote."
  active="areas"
  crumbs={crumbs}
>
  <Hero variant="text-only" title="Areas we cover" sub="Fire risk assessments and related fire-safety services across London and the Home Counties. Each area page covers local housing, council licensing and the fire safety law that applies." crumbs={crumbs} />
  {groups.map((g) => g.list.length > 0 && (
    <section class="sec-int reveal">
      <div class="wrap">
        <p class="eyebrow">{g.eyebrow}</p>
        <p class="lead" style="max-width:70ch">{g.lead}</p>
        <ul class="cards">
          {g.list.map((a) => (
            <li>
              <a class="card" href={`/areas/${a.slug}`}>
                <h3>{a.name}</h3>
                <p>{a.heroSub}</p>
                <span class="arrowlink">Fire safety in {a.name} <span class="ar" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <CtaBand title="Near London but not listed? Ask us." loc="areas-hub" />
  <QuoteSection source="areas-hub" />
</BaseLayout>
