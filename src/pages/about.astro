---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import CtaBand from '../components/CtaBand.astro';
import OtherServices from '../components/OtherServices.astro';
import { confirmedCredentials, site } from '../config/site';
import FIcon from '../components/FIcon.astro';
import Process from '../components/Process.astro';
import { credentialIcon } from '../lib/icons';
const crumbs = [{ name: 'About', href: '/about' }];
const principles = [
  { title: 'Prompt, responsive scheduling', text: 'We work around your building, residents and deadlines, and keep you updated from enquiry to report.' },
  { title: 'Clear reports, practical actions', text: 'Significant findings and actions set out by priority, written so a landlord, agent or contractor can act on them.' },
  { title: 'Remedial works if you want them', text: 'We can undertake or arrange the works an assessment identifies, quoted separately. You are never obliged to use us.' },
  { title: 'Non-destructive and honest about limits', text: 'We assess what is accessible and say plainly where concealed construction needs further investigation.' },
  { title: 'Competence matched to the building', text: 'If a building is outside what we can assess competently, we will tell you before we quote.' },
  { title: 'Scope and price agreed in writing', text: 'No surprises on the day. You know what is covered and what it costs before we visit.' },
];
---
<BaseLayout
  title="About T&T Fire Safety | Fire Risk Assessors"
  description="T&T Fire Safety carries out fire risk assessments and related fire-safety services for landlords, managing agents and businesses across London and the Home Counties."
  active="about"
  crumbs={crumbs}
>
  <Hero title="About T&T Fire Safety" sub="Fire risk assessments and related fire-safety services for landlords, managing agents and businesses across London and the Home Counties." image="report" crumbs={crumbs} />

  <section class="sec-int reveal">
    <div class="wrap">
      <h2>How we work</h2>
      <div class="grid3">{principles.map((p) => <div class="gitem"><FIcon for={p.title} /><h3>{p.title}</h3><p>{p.text}</p></div>)}</div>
    </div>
  </section>

  <section class="credband reveal">
    <div class="wrap">
      <div>
        <h2>Who carries out your assessment</h2>
        <p>T&amp;T works through a network of competent fire risk assessors, engineers and contractors. All our fire risk assessors are members of the Institute of Fire Safety Managers (IFSM), and each assessment is matched to an assessor whose competence suits the premises, using the framework in BS 8674:2025, the British Standard for individual fire risk assessors.</p>
      </div>
      {confirmedCredentials.length > 0 && (
        <div class="credlist">
          <p class="eyebrow">Competence &amp; cover</p>
          <ul>{confirmedCredentials.map((c) => <li><FIcon name={credentialIcon(c.label)} /><div>{c.label}<span>{c.detail}</span></div></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <Process />

  <CtaBand title="Questions before you book? Talk to us." text={`Call ${site.phone.display}, ${site.hours.display}.`} loc="about-band" />

  <OtherServices eyebrow="What we do" />

  <QuoteSection source="about" />
</BaseLayout>
