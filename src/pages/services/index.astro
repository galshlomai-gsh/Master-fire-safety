---
import FIcon from '../../components/FIcon.astro';
import { serviceIcon } from '../../lib/icons';
import { Picture } from 'astro:assets';
import { images, type ImageKey } from '../../config/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import SectorTiles from '../../components/SectorTiles.astro';
import { services, serviceUrl } from '../../data/services';
const crumbs = [{ name: 'Services', href: '/services' }];
---
<BaseLayout
  title="Fire Safety Services for Landlords & Businesses | T&T"
  description="Fire risk assessments, fire door inspections, fire alarm and emergency lighting servicing, and AOV testing for landlords, managing agents and businesses. Free quote."
  active="services"
  crumbs={crumbs}
>
  <Hero title="Fire safety services" sub="Assessments, inspections and servicing for residential and commercial buildings across London and the Home Counties." image="alarmPanel" crumbs={crumbs} />
  <section class="sec-int">
    <div class="wrap">
      <ul class="cards">
        {services.map((s) => (
          <li>
            <a class:list={['card', { hasimg: !!images[s.key as ImageKey].src }]} href={serviceUrl(s)}>
              {images[s.key as ImageKey].src && <Picture class="cardimg" src={images[s.key as ImageKey].src!} alt="" formats={['avif', 'webp']} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />}
              <FIcon name={serviceIcon[s.key]} class="lg" />
              <h3>{s.name}</h3>
              <p>{s.heroSub}</p>
              <span class="arrowlink">View service <span class="ar" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title="Several services due on one building? Get them quoted together." loc="services-hub" />
  <SectorTiles />
  <QuoteSection source="services-hub" />
</BaseLayout>
