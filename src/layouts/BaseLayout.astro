---
import '../styles/global.css';
import '../styles/friendly.css';
// One variable font file (27 KB) covers every weight the site uses (400–800), instead of four
// static files (~48 KB, the 600/800 ones discovered late). It is preloaded below.
import jakartaVar from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
const fontFace = `@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-display:swap;font-weight:200 800;src:url(${jakartaVar}) format('woff2');}`;
import Header, { type Section } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site } from '../config/site';
import { orgSchema, breadcrumbSchema, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  active?: Section;
  crumbs?: Crumb[]; // excluding Home
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}
const { title, description, active = 'none', crumbs = [], schema = [], noindex = false, ogType = 'website' } = Astro.props;
const siteUrl = Astro.site!;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, siteUrl).toString();
// The live production deploy (www.tandtfiresafety.co.uk) is indexable; previews never are.
// ALLOW_INDEXING=false switches indexing off in production, =true forces it on elsewhere.
const allow = process.env.ALLOW_INDEXING;
const indexable = !noindex && (allow === 'true' || (process.env.VERCEL_ENV === 'production' && allow !== 'false'));
const gtm = site.tracking.gtmId;
const clarity = site.tracking.clarityId;
const allSchema = [
  orgSchema(siteUrl),
  ...(crumbs.length ? [breadcrumbSchema(siteUrl, [{ name: 'Home', href: '/' }, ...crumbs])] : []),
  ...schema,
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={jakartaVar} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace}></style>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-default.png', siteUrl).toString()} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};
      (function(){var c=null;try{c=localStorage.getItem('tt_consent');}catch(e){}var g=c==='granted'?'granted':'denied';
      gtag('consent','default',{ad_storage:g,analytics_storage:g,ad_user_data:g,ad_personalization:g,functionality_storage:'granted',security_storage:'granted',wait_for_update:500});
      gtag('set','ads_data_redaction',g==='denied');})();
    </script>
    {(gtm || clarity) && (
      <script is:inline define:vars={{ gtm, clarity }}>
        // Page speed: GTM and Clarity are third-party scripts that compete with the hero for
        // bandwidth and CPU. They load once the page has rendered (window load + idle), or at the
        // first tap/scroll/keypress, whichever comes first. dataLayer and the clarity() queue
        // exist from the start, so nothing pushed before then is lost.
        if(clarity){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments)};
          // Clarity runs cookieless until the visitor accepts in the consent banner.
          var c=null;try{c=localStorage.getItem('tt_consent');}catch(e){}
          var g=c==='granted'?'granted':'denied';
          window.clarity('consentv2',{ad_Storage:g,analytics_Storage:g});}
        (function(){
          var done=false,evs=['pointerdown','keydown','touchstart','scroll'];
          function add(src){var s=document.createElement('script');s.async=true;s.src=src;document.head.appendChild(s);}
          function load(){
            if(done)return;done=true;
            evs.forEach(function(e){removeEventListener(e,load,{passive:true});});
            if(gtm){dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});add('https://www.googletagmanager.com/gtm.js?id='+gtm);}
            if(clarity)add('https://www.clarity.ms/tag/'+clarity);
          }
          evs.forEach(function(e){addEventListener(e,load,{passive:true});});
          function idle(){(window.requestIdleCallback||function(f){setTimeout(f,1);})(load,{timeout:1500});}
          if(document.readyState==='complete')idle();else addEventListener('load',idle);
        })();
      </script>
    )}
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>}
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <ConsentBanner />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
